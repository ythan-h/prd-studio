# OpenRouter API Key — get one free at https://openrouter.ai/keys
# No credit card required for the free tier (50 req/day)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — override the default free model
# Other free options: meta-llama/llama-3.3-70b-instruct:free,
#                    google/gemini-2.0-flash-exp:free,
#                    qwen/qwen-2.5-72b-instruct:free
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Optional — your deployed URL (used for OpenRouter ranking)
APP_URL=https://prd-studio.vercel.app

# Server (local dev only)
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
