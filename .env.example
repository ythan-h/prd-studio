# OpenRouter API Key — get one free at https://openrouter.ai/keys
# No credit card required for the free tier (50 req/day)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — override the default free model (first in the fallback chain)
# Other free options: google/gemma-4-31b-it:free,
#                    google/gemma-4-26b-a4b-it:free,
#                    nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Check https://openrouter.ai/models?max_price=0 for the current free roster.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# Optional — your deployed URL (used for OpenRouter ranking)
APP_URL=https://prd-studio.vercel.app

# Server (local dev only)
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
